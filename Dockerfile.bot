FROM python:3.12-slim

# WeasyPrint needs the Pango/GDK stack for PDF rendering.
# Playwright is intentionally excluded — saves ~500MB and fits in Fly.io free 256MB.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    shared-mime-info \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
# Install everything except playwright (not needed for the bot)
RUN pip install --no-cache-dir \
    requests \
    beautifulsoup4 \
    groq \
    weasyprint

COPY . .

CMD ["python", "bot_listener.py"]
